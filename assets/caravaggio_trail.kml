<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>The Caravaggio Trail (One-Day Itinerary)</name>
    <description>Curated walking route through Rome to experience Michelangelo Merisi da Caravaggio’s public altarpieces, gallery collections, and historic studio.</description>
    <Style id="caravaggioLine">
      <LineStyle>
        <color>ff59a0c5</color>
        <width>4</width>
      </LineStyle>
    </Style>
    <Style id="caravaggioStop">
      <IconStyle>
        <color>ff59a0c5</color>
        <scale>1.1</scale>
      </IconStyle>
    </Style>
    <Placemark>
      <name>1. Chiesa di San Luigi dei Francesi</name>
      <description>Masterpieces: The Saint Matthew Cycle (The Calling of Saint Matthew, The Inspiration of Saint Matthew, and The Martyrdom of Saint Matthew), Contarelli Chapel. Bring €1 or €2 coins to light the chapel. Free admission.</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.47458,41.89958,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>2. Basilica di Sant’Agostino</name>
      <description>Masterpiece: Madonna di Loreto (Madonna dei Pellegrini), Cavalletti Chapel. Free admission (open daily).</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.47431,41.90063,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>3. Casa di Caravaggio (Vicolo del Divino Amore)</name>
      <description>Historic Studio & Haunt: Caravaggio residence and atelier (1603–1605). Near Maddalena Antognetti (Lena) home at Via dei Prefetti.</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.47644,41.90222,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>4. Basilica di Santa Maria del Popolo</name>
      <description>Masterpieces: The Crucifixion of Saint Peter and The Conversion on the Way to Damascus, Cerasi Chapel. Free admission (bring coins for lights).</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.47641,41.91147,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>5. Galleria Borghese</name>
      <description>Masterpieces: Boy with a Basket of Fruit, Young Sick Bacchus, David with the Head of Goliath, Madonna and Child with Saint Anne, Saint Jerome Writing. Advance timed-entry tickets required.</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.49218,41.91421,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>6. Palazzo Barberini</name>
      <description>Masterpieces: Judith Beheading Holofernes, Narcissus, Saint Francis in Meditation. Last entrance 6:00 PM; closed Mondays.</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.49014,41.90349,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>7. Galleria Doria Pamphilj</name>
      <description>Masterpieces: Rest on the Flight into Egypt, Penitent Magdalene, John the Baptist (Youth with a Ram). Closed Wednesday, open until 8 pm Friday-Sunday.</description>
      <styleUrl>#caravaggioStop</styleUrl>
      <Point>
        <coordinates>12.4812,41.89773,0</coordinates>
      </Point>
    </Placemark>
