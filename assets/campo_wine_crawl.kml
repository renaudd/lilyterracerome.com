<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Campo Wine Crawl</name>
    <description>Curated 7-stop wine crawl through the historic center of Rome near Campo de' Fiori.</description>
    <Style id="routeStyle">
      <LineStyle>
        <color>ff59a0c5</color>
        <width>4</width>
      </LineStyle>
    </Style>
    <Placemark>
      <name>1. L’Angolo Divino Enoteca</name>
      <description><![CDATA[<b>★★★★★ · €6-€8</b><br><br>Directly downstairs from the apartment. Superb wines and knowledgeable English-speaking docents.<br><br><a href="https://www.google.com/maps/search/?api=1&query=L+Angolo+Divino+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4721353,41.8946511,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>2. Vinaietto - Old Winery</name>
      <description><![CDATA[<b>★★★★★ · €5-€8</b><br><br>Historic local enoteca. Even their house pours are top tier. Great vinyl tunes and lively crowd.<br><br><a href="https://www.google.com/maps/search/?api=1&query=Il+Vinaietto+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4749205,41.8946458,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>3. Ruma Bottega &amp; Cucina Agricola</name>
      <description><![CDATA[<b>★★★★ · €6-€9</b><br><br>Artisanal natural wines, exceptional organic cheeses, and house-made gelato.<br><br><a href="https://www.google.com/maps/search/?api=1&query=Ruma+Bottega+Cucina+Agricola+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4708953,41.8987358,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>4. Vino e vinili Roma</name>
      <description><![CDATA[<b>★★★ · €8</b><br><br>Intimate spot in Campo Marzio pairing Italian wines with spinning vinyl records.<br><br><a href="https://www.google.com/maps/search/?api=1&query=Vino+e+vinili+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4703835,41.8969334,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>5. Enoteca Bortone</name>
      <description><![CDATA[<b>★★★★ · €9</b><br><br>Along Via dei Banchi Vecchi. Outstanding, carefully curated cellar selections.<br><br><a href="https://www.google.com/maps/search/?api=1&query=Enoteca+Bortone+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4682361,41.8972144,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>6. La Barchetta</name>
      <description><![CDATA[<b>★★★★ · €8-€18</b><br><br>Right next door to Bortone—atmospheric wine bar with extensive regional bottles.<br><br><a href="https://www.google.com/maps/search/?api=1&query=Enoteca+La+Barchetta+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4683823,41.8971181,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>7. Il Goccetto</name>
      <description><![CDATA[<b>★★★ · €7</b><br><br>Beloved 1980s institution with 16th-century painted ceilings, 800+ bottles, and classic aperitivo.<br><br><a href="https://www.google.com/maps/search/?api=1&query=Il+Goccetto+Rome">Open in Google Maps</a>]]></description>
      <Point>
        <coordinates>12.4673538,41.8978195,0</coordinates>
      </Point>
    </Placemark>
